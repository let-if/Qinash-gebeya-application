{
  "expo": {
    "name": "ቅናሽ ገበያ",
    "slug": "b2b-retail-adama-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "gebeya",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shop GPS is used once to pin delivery location."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-video"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0F7B4A"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.letif.b2bretailadama"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "",
      "router": {},
      "eas": {
        "projectId": "492f2b03-ed39-42cc-afba-8d1db7f1f6e3"
      }
    },
    "owner": "letifylkal"
  }
}
